# Блок для Caddyfile РемЗапа (/opt/remzap/docker/Caddyfile и репозиторий crm_spare_parts).
# Caddy сам получит сертификат Let's Encrypt для поддомена sslip.io.
afisha.193-47-33-213.sslip.io {
	encode zstd gzip
	header -Server
	reverse_proxy afisha-app:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# Старый адрес: переадресация, чтобы работали уже разосланные ботами ссылки и встроенные виджеты
afish.193-47-33-213.sslip.io {
	redir https://afisha.193-47-33-213.sslip.io{uri} permanent
}
