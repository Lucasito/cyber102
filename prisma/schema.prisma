// Афиша культуры Башкортостана — модель данных (схема события — ТЗ, раздел 8.1; соответствие полей — docs/ARCHITECTURE.md).
//
// Принципы:
//  • Только реальные события: у каждого есть источник (sourceUrl) — выдуманных нет.
//  • Дедупликация: dedupKey = нормализованные (название + площадка + дата начала);
//    одно событие из нескольких источников — одна запись, источники в EventSource.
//  • Цены в рублях целыми (Int); null — неизвестно, 0 — бесплатно.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * Публикация: черновик не виден посетителям (ТЗ 6.1: «опубликовано», «черновик»; «отменено» — EventStatus).
 */
enum Publication {
  DRAFT
  PUBLISHED
}

/**
 * Тип источника (ТЗ 8.1 source_type).
 */
enum SourceType {
  MANUAL // ручной ввод в админке
  IMPORT // файл CSV/JSON
  RSS
  API
  PAGE // страница учреждения
}

enum EventStatus {
  SCHEDULED // запланировано
  RESCHEDULED // перенесено
  CANCELLED // отменено
  SOLD_OUT // билетов нет
  PAST // прошло
}

model Category {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  events Event[]
}

model Venue {
  id         String    @id @default(cuid())
  name       String
  city       String
  address    String?
  lat        Float?
  lon        Float?
  geocodedAt DateTime? // когда искали координаты по адресу (найдены или нет) — чтобы не повторять
  events     Event[]

  @@unique([name, city])
  @@index([city])
}

model Event {
  id               String        @id @default(cuid())
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime?
  status           EventStatus   @default(SCHEDULED)
  priceMin         Int?
  priceMax         Int?
  ageLimit         Int? // возрастное ограничение: 0, 6, 12, 16, 18
  imageUrl         String?
  ticketUrl        String?
  pushkinCard      Boolean       @default(false) // можно оплатить Пушкинской картой
  accessibility    String[]      @default([]) // доступная среда: wheelchair, hearing, vision
  dedupKey         String        @unique
  normalizedTitle  String        @default("") // для дедупликации и поиска (ТЗ 8.1)
  tags             String[]      @default([]) // метки: джаз, дети, башкирский язык…
  language         String? // язык мероприятия, если указан
  durationMin      Int? // длительность, если известна
  orgUrl           String? // организатор (билеты — ticketUrl)
  publication      Publication   @default(PUBLISHED)
  needsReview      Boolean       @default(false) // спорная карточка — в очередь модерации
  possibleDuplicateId String? // похоже на это событие из другого источника — решает модератор («Объединить» / «Разные»)
  distinctFrom     String[]      @default([]) // модератор решил: не дубль этих событий — в поиске дублей пара больше не показывается
  createdById      String? // кто добавил в админке (организатор видит свои события)
  createdBy        AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reviewNote       String? // почему спорная
  originalStartsAt DateTime? // прежняя дата, если событие перенесено
  verifiedAt       DateTime? // когда источник проверен
  confidence       Float? // уверенность извлечения 0–1
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  venueId          String?
  venue            Venue?        @relation(fields: [venueId], references: [id])
  sources          EventSource[]
  reminders        Reminder[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([publication, needsReview])
}

/**
 * Откуда событие взято: подтверждение достоверности и основа дедупликации.
 */
model EventSource {
  id         String     @id @default(cuid())
  eventId    String
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source     String // код источника: culture_rb, pushkin_card, theatre_site …
  sourceType SourceType @default(IMPORT)
  externalId String?
  url        String
  sourceHash String? // хеш исходной записи — повторная загрузка той же записи ничего не меняет
  fetchedAt  DateTime   @default(now())

  @@unique([eventId, source, url]) // одна ссылка (страница постановки) может вести к нескольким сеансам
  @@index([source, url])
  @@index([source, externalId])
}

/**
 * Пользователь бота (MAX, Telegram) и контекст диалога с ИИ-агентом.
 */
model BotUser {
  id            String         @id @default(cuid())
  platform      String // max | telegram
  externalId    String // id пользователя в мессенджере
  name          String?
  dialog        Json? // последние сообщения для уточняющих вопросов агента
  browse        Json? // фильтры поиска кнопками: город, категория, даты, цена, страница
  messages      Int            @default(0)
  reminders     Reminder[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())

  @@unique([platform, externalId])
}

/**
 * Настройки, которые меняются из админки (key — раздел: site, ai, max, telegram).
 */
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/**
 * Напоминание о событии в боте: «Напомнить» под событием → сообщение за день (или за 2 часа) до начала.
 */
model Reminder {
  id        String    @id @default(cuid())
  botUserId String
  botUser   BotUser   @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([botUserId, eventId])
  @@index([sentAt, remindAt])
}

/**
 * Журнал запросов к помощнику — для аналитики в админке.
 */
model QueryLog {
  id        String   @id @default(cuid())
  source    String // site | api | max | telegram
  text      String
  filter    Json?
  results   Int      @default(0)
  clarify   Boolean  @default(false) // помощник задал уточняющий вопрос
  relaxed   Boolean  @default(false) // точных совпадений не было, фильтр ослаблен
  degraded  Boolean  @default(false) // ответ без ИИ (перегрузка)
  // Трасса ответа агента (ТЗ 7.4): кто спросил, режим, задержка, токены, стоимость, события-основания, шаги
  userKey   String? // ip:… — сайт и API; max:… / telegram:… — пользователь бота
  dialogKey String? // диалог: хеш пользователя и первой реплики — для лимита стоимости на диалог
  mode      String   @default("ai") // ai — с ИИ; mixed — часть шагов без ИИ; rules — без ИИ; limit — превышен лимит стоимости
  latencyMs Int      @default(0)
  tokens    Int      @default(0)
  costRub   Float    @default(0)
  eventIds  String[] @default([])
  trace     Json? // шаги: разбор, правила, поиски с фильтрами, ослабления, объяснение, вызовы модели
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userKey, createdAt])
  @@index([dialogKey])
}

/**
 * Пользователи админки. Роль ADMIN — всё, включая настройки и пользователей; MODERATOR — работа с событиями.
 * Пароль хранится как scrypt-хеш (lib/server/password.ts).
 */
enum AdminRole {
  ADMIN
  MODERATOR
  ORGANIZER // организатор: добавляет события по одному или файлом, всё — через модерацию
}

model AdminUser {
  id              String         @id @default(cuid())
  login           String         @unique
  email           String?        @unique // для восстановления пароля и приглашений
  name            String?
  passwordHash    String
  role            AdminRole      @default(MODERATOR)
  active          Boolean        @default(true)
  sessions        AdminSession[]
  tokens          AdminToken[]
  lastLoginAt     DateTime?
  failedLogins    Int            @default(0) // неудачных попыток подряд
  lockedUntil     DateTime? // вход закрыт до этого времени (защита от подбора)
  organization    String? // организатор: учреждение или компания
  pendingApproval Boolean        @default(false) // заявка организатора с сайта ждёт решения модератора (вход закрыт)
  phone           String? // заявка организатора: телефон для связи (по желанию)
  website         String? // заявка организатора: сайт учреждения
  applicationNote String? // заявка организатора: что будет размещать
  events          Event[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

/**
 * Сессия входа: в cookie — случайный токен, в базе — только его SHA-256.
 */
model AdminSession {
  id        String    @id // sha256(токен)
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * Одноразовая ссылка из письма: сброс пароля или приглашение. В базе — только SHA-256 токена.
 */
model AdminToken {
  id        String    @id // sha256(токен)
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // reset | invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * Сырая запись источника (строка файла, элемент RSS…) — хранится отдельно от нормализованного события,
 * чтобы нормализацию можно было переиграть без повторного сбора (ТЗ 6.1).
 */
model RawRecord {
  id         String     @id @default(cuid())
  source     String
  sourceType SourceType
  hash       String // sha256 канонического JSON записи
  payload    Json
  importId   String?
  import     ImportRun? @relation(fields: [importId], references: [id], onDelete: SetNull)
  eventId    String? // событие, в которое запись нормализована (null — отклонена)
  error      String? // почему отклонена
  createdAt  DateTime   @default(now())

  @@unique([source, hash])
  @@index([eventId])
}

/**
 * Загрузка файла: итог и отчёт по строкам (ТЗ 6.1 — «добавлено, обновлено, отклонено и почему»).
 */
model ImportRun {
  id        String      @id @default(cuid())
  fileName  String
  source    String
  total     Int         @default(0)
  created   Int         @default(0)
  updated   Int         @default(0)
  unchanged Int         @default(0)
  rejected  Int         @default(0)
  report    Json // [{ row, result, reason?, eventId? }]
  userLogin String?
  records   RawRecord[]
  createdAt DateTime    @default(now())
}

/**
 * Журнал изменений: кто, когда и что изменил (ТЗ 6.1).
 */
model AuditLog {
  id        String   @id @default(cuid())
  userLogin String? // null — система (импорт по расписанию, фоновые задачи)
  action    String // create | update | publish | unpublish | cancel | delete | import | approve …
  entity    String // event | import | user | settings
  entityId  String?
  summary   String // кратко по-русски
  diff      Json? // { поле: [было, стало] }
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/**
 * Подписка из бота на новые события города и категории (ТЗ 6.2). Только идентификатор пользователя и фильтр —
 * без персональных данных; отписка удаляет запись. Уведомления — не чаще раза в день (lib/server/jobs.ts).
 */
model Subscription {
  id           String   @id @default(cuid())
  botUserId    String? // подписка из бота; null — через API (лента по секретной ссылке)
  botUser      BotUser? @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  secret       String?  @unique // ключ подписки через API: лента и отписка — только с ним
  city         String? // null — любой город
  category     String? // slug категории; null — любая
  notifiedUpTo DateTime @default(now()) // события, добавленные позже, — новые для подписчика
  createdAt    DateTime @default(now())

  @@unique([botUserId, city, category])
}

/**
 * Обращение с сайта или через API (ТЗ 6.3): заявка организатора, уточнение по событию, вопрос.
 * Контакт — только если человек сам его оставил для ответа; хранится 365 дней (README, «Персональные данные»).
 */
model Feedback {
  id        String   @id @default(cuid())
  kind      String // organizer | correction | question
  eventId   String?
  name      String?
  contact   String? // почта или телефон для ответа — по желанию
  message   String
  source    String   @default("site") // site | api | bot
  status    String   @default("new") // new | done
  handledBy String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/**
 * Кеш геокодера (Nominatim / OpenStreetMap): адрес или населённый пункт → координаты и регион.
 */
model GeoCache {
  query     String   @id // нормализованный запрос
  found     Boolean
  lat       Float?
  lon       Float?
  region    String? // субъект РФ: «Башкортостан»
  display   String?
  createdAt DateTime @default(now())
}

/**
 * Внешний источник событий для сборщика (раздел «Источники» в админке, доступен модераторам).
 * kind: universal_json / universal_rss — наш универсальный формат (/docs/format), без ИИ;
 * rss_ai — обычная RSS-лента, карточки разбирает ИИ, всё — через модерацию;
 * jsonld — страница с разметкой schema.org Event; custom — индивидуальный парсер (adapter).
 */
model Source {
  id            String       @id @default(cuid())
  code          String       @unique // код в EventSource.source: sgtko, bashgf …
  name          String
  kind          String
  url           String
  adapter       String? // kind = custom: ключ парсера из lib/server/collect/adapters.ts
  city          String? // город по умолчанию, если в записи его нет
  autoPublish   Boolean      @default(false) // прошедшие проверку — сразу в афишу (у rss_ai — всегда модерация)
  enabled       Boolean      @default(true)
  intervalHours Int          @default(6)
  maxItems      Int          @default(20) // новых записей за запуск: у rss_ai ограничивает расходы на ИИ
  note          String?
  lastRunAt     DateTime?
  lastStatus    String? // ok | error
  lastMessage   String?
  createdBy     String?
  items         SourceItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/**
 * Запись источника (элемент ленты): разобрана один раз — повторно ИИ не тратится.
 */
model SourceItem {
  id        String   @id @default(cuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  guid      String
  link      String?
  title     String?
  status    String // imported | rejected | error
  reason    String?
  eventId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, guid])
}
