{
  "name": "afisha-rb",
  "version": "0.1.0",
  "private": true,
  "description": "Афиша культуры Башкортостана: веб-сервис, REST API, виджет, бот MAX, ИИ-агент",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:data-quality": "tsx --conditions=react-server scripts/data-quality-test.mts",
    "test:data-quality:ui": "tsx --conditions=react-server scripts/data-quality-test.mts --ui",
    "test:cinemas": "tsx --conditions=react-server scripts/cinema-checks.mts",
    "test:visitor:browser": "tsx --conditions=react-server scripts/data-quality-test.mts --browser",
    "db:up": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "ai:check": "tsx --conditions=react-server scripts/ai-check.mts",
    "eval": "tsx --conditions=react-server scripts/eval.mts",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "sources:seed": "tsx scripts/seed-sources.mts",
    "sources:preview": "tsx --conditions=react-server scripts/sources-preview.mts",
    "sources:run": "tsx --conditions=react-server scripts/sources-run.mts",
    "logo:export": "node scripts/export-logo.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
