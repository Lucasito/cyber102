# ───── Приложение ─────
# Публичный адрес (ссылки в ботах, документация API, виджет). Локально — http://localhost:3000
PUBLIC_URL="https://afish.193-47-33-213.sslip.io"
# Локально: npm run db:up поднимает PostgreSQL на 127.0.0.1:5435
DATABASE_URL="postgresql://afisha:afisha@localhost:5435/afisha"
# Только для сервера (docker-compose.prod.yml)
POSTGRES_PASSWORD=""

# ───── Админка ─────
# Вход: <PUBLIC_URL>/admin/enter/<ADMIN_KEY>. Не менее 16 символов; пусто — админка выключена.
# Сгенерировать: openssl rand -hex 24
ADMIN_KEY=""

# ───── Бот MAX ─────
# polling — сервер сам опрашивает MAX; webhook — MAX шлёт события на /api/max/webhook
MAX_MODE="polling"
MAX_WEBHOOK_SECRET=""

# Ключи ИИ (GigaChat, OpenAI-совместимый) и токены ботов (MAX, Telegram) задаются в АДМИНКЕ.
# Переменные GIGACHAT_AUTH_KEY, GIGACHAT_SCOPE, GIGACHAT_MODEL, LLM_API_URL, LLM_API_KEY, LLM_MODEL,
# MAX_BOT_TOKEN, TELEGRAM_BOT_TOKEN, TELEGRAM_API_URL поддерживаются как запасные значения (если поле
# в админке пустое), но не нужны. Перенести из .env в админку: npx tsx scripts/env-to-settings.mts
# AI_PROVIDER="none" — аварийно выключить ИИ.
